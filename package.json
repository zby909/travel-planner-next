{
  "name": "travel-planner-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint src scripts cli/src",
    "cli:build": "tsc -p cli/tsconfig.json",
    "cli:check": "tsc -p cli/tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "node scripts/check-data.mjs",
    "media:cleanup": "node scripts/prune-staged-media.mjs",
    "user:create": "node scripts/create-user.mjs",
    "test:auth:e2e": "node scripts/run-auth-e2e.mjs",
    "test:import:e2e": "node scripts/run-import-e2e.mjs",
    "test:bootstrap": "node scripts/test-bootstrap.mjs",
    "test:production:smoke": "node scripts/test-production-smoke.mjs",
    "test:backup:restore": "node scripts/run-backup-restore-e2e.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "16.4.3",
    "prisma": "^6.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "yazl": "^3.3.1"
  }
}

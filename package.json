{
  "name": "travel-planner-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint src prisma/seed.ts scripts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "node scripts/check-data.mjs",
    "media:cleanup": "node scripts/prune-staged-media.mjs",
    "user:create": "node scripts/create-user.mjs",
    "test:auth:e2e": "node scripts/run-auth-e2e.mjs",
    "test:import:e2e": "node scripts/run-import-e2e.mjs",
    "test:bootstrap": "node scripts/test-bootstrap.mjs",
    "test:production:smoke": "node scripts/test-production-smoke.mjs",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "16.4.3",
    "prisma": "^6.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  displayName  String
  passwordHash String
  role         String        @default("EDITOR")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  auditLogs    AuditLog[]
  apiTokens    ApiToken[]
  importDrafts ImportDraft[]
  mediaAssets  MediaAsset[]
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  username    String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  summary   String
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  title      String
  tokenHash  String    @unique
  scopesJson String
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ImportDraft {
  id          String    @id @default(cuid())
  ownerId     String
  kind        String
  payloadJson String
  status      String    @default("PREPARED")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  committedAt DateTime?
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
}

model MediaAsset {
  id        String   @id @default(cuid())
  ownerId   String
  fileName  String
  mimeType  String
  byteSize  Int
  status    String   @default("STAGED")
  createdAt DateTime @default(now())
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  travelPhoto TravelPhoto?

  @@index([ownerId, status])
}

model Destination {
  id              String              @id
  title           String
  subtitle        String
  imagePath       String?
  flag            String
  kind            String
  typesJson       String
  months          String
  seasonsJson     String
  days            String
  minBudget       Int
  maxBudget       Int
  pickBudget      Int
  rank            Int
  budgetAccommodation Int
  budgetFood          Int
  budgetTransport    Int
  budgetOther        Int
  groupText           String
  vibe                String
  reason              String
  spotsJson           String
  routeJson           String
  warning             String?
  style               String?
  badge               String?
  isArchived      Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  guide               DestinationGuide?
  plans               TravelPlan[]

  @@index([rank])
}

model DestinationGuide {
  destinationId String      @id
  intro         String
  pace          String
  stay          String
  transport     String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  days          GuideDay[]
}

model GuideDay {
  id        String           @id
  guideId   String
  day       String
  title     String
  detail    String
  sortOrder Int
  guide     DestinationGuide @relation(fields: [guideId], references: [destinationId], onDelete: Cascade)

  @@unique([guideId, sortOrder])
}

model VisitedPlace {
  id        String          @id
  group     String
  name      String
  region    String
  image     String
  whenLabel String
  sortOrder Int
  longitude Float?
  latitude  Float?
  country   String?
  province  String?
  city      String?
  mapNote   String?
  isArchived Boolean        @default(false)
  timeline  TimelinePlace[]
  memories  TravelMemory[]

  @@index([group, sortOrder])
}

model TimelineEntry {
  id        String          @id
  date      String
  year      Int
  group     String
  title     String
  note      String
  sortOrder Int
  places    TimelinePlace[]

  @@index([year, sortOrder])
}

model TimelinePlace {
  timelineEntryId String
  placeId         String
  sortOrder       Int
  timelineEntry   TimelineEntry @relation(fields: [timelineEntryId], references: [id], onDelete: Cascade)
  place           VisitedPlace  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([timelineEntryId, placeId])
  @@index([placeId])
}

model TravelPlan {
  id            String            @id @default(cuid())
  title         String
  destinationId String?
  startDate     DateTime?
  endDate       DateTime?
  status        String            @default("PLANNED")
  plannedBudget Int?
  currency      String            @default("CNY")
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  destination   Destination?      @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  guides        TravelGuideLink[]
  expenses      Expense[]
  memories      TravelMemory[]
  photos        TravelPhoto[]     @relation("PlanPhotos")

  @@index([status, startDate])
}

model TravelGuideLink {
  id          String     @id @default(cuid())
  planId      String
  dayDate     DateTime?
  title       String
  url         String
  coverImage  String?
  description String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  plan        TravelPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, dayDate, sortOrder])
}

model Expense {
  id          String     @id @default(cuid())
  planId      String
  category    String
  amountMinor Int
  description String
  spentAt     DateTime?
  createdAt   DateTime   @default(now())
  plan        TravelPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, spentAt])
  @@index([category])
}

model TravelMemory {
  id         String        @id @default(cuid())
  planId     String?
  title      String
  content    String
  happenedAt DateTime?
  placeId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  plan       TravelPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  place      VisitedPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)
  photos     TravelPhoto[] @relation("MemoryPhotos")

  @@index([planId, happenedAt])
  @@index([placeId])
}

model TravelPhoto {
  id        String        @id @default(cuid())
  planId    String?
  memoryId  String?
  filePath     String
  mediaAssetId String?       @unique
  altText      String?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  plan         TravelPlan?   @relation("PlanPhotos", fields: [planId], references: [id], onDelete: SetNull)
  memory       TravelMemory? @relation("MemoryPhotos", fields: [memoryId], references: [id], onDelete: SetNull)
  mediaAsset   MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([planId, sortOrder])
  @@index([memoryId, sortOrder])
}
